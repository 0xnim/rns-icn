[Unit]
Description=Space weather feed for the ICN node (NOAA SWPC)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=icn
Group=icn
ExecStart=/usr/bin/python3 /opt/rns-icn/feeds/spaceweather.py /var/lib/rns-icn/publish
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rns-icn/publish
