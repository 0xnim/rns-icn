[Unit]
Description=ICN Origin Server (rns-icn)
# Rides the shared rnsd transport daemon; start after it is up.
After=network-online.target rnsd.service
Wants=network-online.target
Requires=rnsd.service

[Service]
Type=simple
User=icn
Group=icn
ExecStart=/opt/rns-icn/venv/bin/icn-server --config /etc/rns-icn/icn.toml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rns-icn /etc/rns-icn /etc/rnsd

[Install]
WantedBy=multi-user.target
